@page "{id:int?}"
@model PersonalBlog.Pages.Admin.EditPodcastModel
@{
    ViewData["Title"] = Model.IsNew ? "Create Podcast Episode" : "Edit Podcast Episode";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-microphone me-2"></i>
            @(Model.IsNew ? "Create New Podcast Episode" : "Edit Podcast Episode")
        </h2>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Episode.Id" />
        
        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Episode Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Episode.Title" class="form-label">Title</label>
                            <input asp-for="Episode.Title" class="form-control" />
                            <span asp-validation-for="Episode.Title" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Episode.EpisodeNumber" class="form-label">Episode Number</label>
                            <input asp-for="Episode.EpisodeNumber" type="number" class="form-control" min="1" />
                            <span asp-validation-for="Episode.EpisodeNumber" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Episode.Slug" class="form-label">Slug</label>
                            <div class="input-group">
                                <span class="input-group-text">/podcast/</span>
                                <input asp-for="Episode.Slug" class="form-control" placeholder="Generated from title if empty" />
                            </div>
                            <span asp-validation-for="Episode.Slug" class="text-danger"></span>
                            <small class="text-muted">Leave empty to generate automatically from title.</small>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Episode.Summary" class="form-label">Summary</label>
                            <textarea asp-for="Episode.Summary" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Episode.Summary" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Episode.AudioUrl" class="form-label">Audio URL</label>
                            <input asp-for="Episode.AudioUrl" class="form-control" placeholder="https://" />
                            <span asp-validation-for="Episode.AudioUrl" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Episode.Guests" class="form-label">Guests</label>
                            <input asp-for="Episode.Guests" class="form-control" placeholder="John Doe, Jane Smith" />
                            <span asp-validation-for="Episode.Guests" class="text-danger"></span>
                            <small class="text-muted">Comma-separated list of guest names.</small>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Episode.PublishedDate" class="form-label">Publish Date</label>
                            <input type="date" asp-for="Episode.PublishedDate" class="form-control" value="@Model.Episode.PublishedDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="Episode.PublishedDate" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Episode.DurationMinutes" class="form-label">Duration (minutes)</label>
                            <input asp-for="Episode.DurationMinutes" type="number" class="form-control" min="1" />
                            <span asp-validation-for="Episode.DurationMinutes" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Episode.Category" class="form-label">Category</label>
                            <div class="input-group">
                                <select asp-for="Episode.Category" class="form-select">
                                    <option value="">-- Select Category --</option>
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category" selected="@(category == Model.Episode.Category)">@category</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#newCategoryModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Episode.Category" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Episode.CategoryBadgeColor" class="form-label">Badge Color</label>
                            <select asp-for="Episode.CategoryBadgeColor" class="form-select">
                                <option value="primary" selected="@(Model.Episode.CategoryBadgeColor == "primary")">Blue</option>
                                <option value="secondary" selected="@(Model.Episode.CategoryBadgeColor == "secondary")">Gray</option>
                                <option value="success" selected="@(Model.Episode.CategoryBadgeColor == "success")">Green</option>
                                <option value="danger" selected="@(Model.Episode.CategoryBadgeColor == "danger")">Red</option>
                                <option value="warning" selected="@(Model.Episode.CategoryBadgeColor == "warning")">Yellow</option>
                                <option value="info" selected="@(Model.Episode.CategoryBadgeColor == "info")">Light Blue</option>
                                <option value="dark" selected="@(Model.Episode.CategoryBadgeColor == "dark")">Dark</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Episode.ImageUrl" class="form-label">Image URL</label>
                            <input asp-for="Episode.ImageUrl" class="form-control" placeholder="https://" />
                            <span asp-validation-for="Episode.ImageUrl" class="text-danger"></span>
                        </div>
                        
                        <div class="form-check mb-3">
                            <input asp-for="Episode.IsFeatured" class="form-check-input" type="checkbox" />
                            <label asp-for="Episode.IsFeatured" class="form-check-label">Featured Episode</label>
                            <p class="text-muted small">Featured episodes appear at the top of the podcast page.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="d-flex justify-content-between">
            <a asp-page="/Admin/Podcasts" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Episodes
            </a>
            <div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Save Episode
                </button>
            </div>
        </div>
    </form>
    
    <!-- New Category Modal -->
    <div class="modal fade" id="newCategoryModal" tabindex="-1" aria-labelledby="newCategoryModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="newCategoryModalLabel">Add New Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newCategory" class="form-label">Category Name</label>
                        <input type="text" id="newCategory" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="addCategoryBtn">Add Category</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle adding new category
            const addCategoryBtn = document.getElementById('addCategoryBtn');
            const categoryInput = document.getElementById('newCategory');
            const categorySelect = document.getElementById('Episode_Category');
            
            addCategoryBtn.addEventListener('click', function() {
                const categoryName = categoryInput.value.trim();
                if (categoryName) {
                    // Check if category already exists
                    let exists = false;
                    for (let i = 0; i < categorySelect.options.length; i++) {
                        if (categorySelect.options[i].value === categoryName) {
                            exists = true;
                            categorySelect.value = categoryName;
                            break;
                        }
                    }
                    
                    // If it doesn't exist, add it
                    if (!exists) {
                        const option = document.createElement('option');
                        option.value = categoryName;
                        option.text = categoryName;
                        option.selected = true;
                        categorySelect.add(option);
                    }
                    
                    // Close modal
                    bootstrap.Modal.getInstance(document.getElementById('newCategoryModal')).hide();
                    categoryInput.value = '';
                }
            });
            
            // Auto-generate slug when typing title
            const titleInput = document.getElementById('Episode_Title');
            const slugInput = document.getElementById('Episode_Slug');
            
            titleInput.addEventListener('input', function() {
                if (slugInput.value === '') {
                    slugInput.value = titleInput.value
                        .toLowerCase()
                        .replace(/[^a-z0-9\s]/g, '')
                        .replace(/\s+/g, '-');
                }
            });
        });
    </script>
} 