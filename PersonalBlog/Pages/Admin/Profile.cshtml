@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle skill proficiency sliders
            const newSkillProficiency = document.getElementById('newSkillProficiency');
            const newSkillProficiencyValue = document.getElementById('newSkillProficiencyValue');
            if (newSkillProficiency && newSkillProficiencyValue) {
                newSkillProficiencyValue.textContent = newSkillProficiency.value + '%';
                newSkillProficiency.addEventListener('input', function() {
                    newSkillProficiencyValue.textContent = this.value + '%';
                });
            }
            
            const editSkillProficiency = document.getElementById('editSkillProficiency');
            const editSkillProficiencyValue = document.getElementById('editSkillProficiencyValue');
            if (editSkillProficiency && editSkillProficiencyValue) {
                editSkillProficiency.addEventListener('input', function() {
                    editSkillProficiencyValue.textContent = this.value + '%';
                });
            }
            
            // Handle skill category edit button
            const editSkillCategoryButtons = document.querySelectorAll('.edit-skill-category-btn');
            editSkillCategoryButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');
                    const description = this.getAttribute('data-description');
                    const order = this.getAttribute('data-order');
                    
                    document.getElementById('editCategoryId').value = id;
                    document.getElementById('editCategoryName').value = name;
                    document.getElementById('editCategoryDescription').value = description;
                    document.getElementById('editCategoryOrder').value = order;
                    
                    const editModal = new bootstrap.Modal(document.getElementById('editSkillCategoryModal'));
                    editModal.show();
                });
            });
            
            // Sync color pickers
            document.getElementById('newSkillIconColorText').addEventListener('input', function() {
                document.getElementById('newSkillIconColor').value = this.value;
            });
            
            document.getElementById('editSkillIconColorText').addEventListener('input', function() {
                document.getElementById('editSkillIconColor').value = this.value;
            });
            
            // Handle skill edit button
            const editSkillButtons = document.querySelectorAll('.edit-skill-btn');
            editSkillButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');
                    const category = this.getAttribute('data-category');
                    const categoryId = this.getAttribute('data-category-id') || '';
                    const proficiency = this.getAttribute('data-proficiency');
                    const proficiencyLevel = this.getAttribute('data-proficiency-level') || 'Intermediate';
                    const icon = this.getAttribute('data-icon');
                    const iconColor = this.getAttribute('data-icon-color') || '#3498db';
                    
                    document.getElementById('editSkillId').value = id;
                    document.getElementById('editSkillName').value = name;
                    document.getElementById('editSkillCategoryText').value = category;
                    
                    // Set select boxes
                    const categorySelect = document.getElementById('editSkillCategory');
                    if (categorySelect) {
                        for(let i = 0; i < categorySelect.options.length; i++) {
                            if (categorySelect.options[i].value === categoryId) {
                                categorySelect.selectedIndex = i;
                                break;
                            }
                        }
                    }
                    
                    const proficiencyLevelSelect = document.getElementById('editSkillProficiencyLevel');
                    if (proficiencyLevelSelect) {
                        for(let i = 0; i < proficiencyLevelSelect.options.length; i++) {
                            if (proficiencyLevelSelect.options[i].value === proficiencyLevel) {
                                proficiencyLevelSelect.selectedIndex = i;
                                break;
                            }
                        }
                    }
                    
                    document.getElementById('editSkillProficiency').value = proficiency;
                    document.getElementById('editSkillProficiencyValue').textContent = proficiency + '%';
                    document.getElementById('editSkillIcon').value = icon;
                    document.getElementById('editSkillIconColor').value = iconColor;
                    document.getElementById('editSkillIconColorText').value = iconColor;
                    
                    const editModal = new bootstrap.Modal(document.getElementById('editSkillModal'));
                    editModal.show();
                });
            });
            
            // Handle experience edit button
            const editExperienceButtons = document.querySelectorAll('.edit-experience-btn');
            editExperienceButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    fetch('/api/experience/' + id)
                        .then(response => {
                            if (!response.ok) {
                                // Handle 404 or other HTTP errors
                                const err = new Error('Experience not found');
                                err.status = response.status;
                                throw err;
                            }
                            return response.json();
                        })
                        .then(experience => {
                            // Fill the form
                            document.getElementById('editExperienceId').value = experience.id;
                            document.getElementById('editExperienceTitle').value = experience.title;
                            document.getElementById('editExperienceCompany').value = experience.company;
                            document.getElementById('editExperienceDescription').value = experience.description;
                            document.getElementById('editExperienceTechnologies').value = experience.technologies;
                            document.getElementById('editExperienceOrder').value = experience.order;
                            
                            // Format dates for the date inputs
                            if (experience.startDate) {
                                document.getElementById('editExperienceStartDate').value = experience.startDate.substring(0, 10);
                            }
                            
                            if (experience.endDate) {
                                document.getElementById('editExperienceEndDate').value = experience.endDate.substring(0, 10);
                                document.getElementById('editExperienceCurrentPosition').checked = false;
                            } else {
                                document.getElementById('editExperienceEndDate').value = '';
                                document.getElementById('editExperienceCurrentPosition').checked = true;
                            }
                            
                            const editModal = new bootstrap.Modal(document.getElementById('editExperienceModal'));
                            editModal.show();
                        })
                        .catch(error => {
                            console.error('Error fetching experience:', error);
                            alert('Could not load experience data. Please try again.');
                        });
                });
            });
            
            // Handle education edit button
            const editEducationButtons = document.querySelectorAll('.edit-education-btn');
            editEducationButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    fetch('/api/education/' + id)
                        .then(response => {
                            if (!response.ok) {
                                // Handle 404 or other HTTP errors
                                const err = new Error('Education not found');
                                err.status = response.status;
                                throw err;
                            }
                            return response.json();
                        })
                        .then(education => {
                            // Fill the form
                            document.getElementById('editEducationId').value = education.id;
                            document.getElementById('editEducationDegree').value = education.degree;
                            document.getElementById('editEducationInstitution').value = education.institution;
                            document.getElementById('editEducationDescription').value = education.description;
                            document.getElementById('editEducationOrder').value = education.order;
                            
                            // Format dates for the date inputs
                            if (education.startDate) {
                                document.getElementById('editEducationStartDate').value = education.startDate.substring(0, 10);
                            }
                            
                            if (education.endDate) {
                                document.getElementById('editEducationEndDate').value = education.endDate.substring(0, 10);
                                document.getElementById('editEducationInProgress').checked = false;
                            } else {
                                document.getElementById('editEducationEndDate').value = '';
                                document.getElementById('editEducationInProgress').checked = true;
                            }
                            
                            const editModal = new bootstrap.Modal(document.getElementById('editEducationModal'));
                            editModal.show();
                        })
                        .catch(error => {
                            console.error('Error fetching education:', error);
                            alert('Could not load education data. Please try again.');
                        });
                });
            });
            
            // Handle "Currently work here" checkbox for Experience
            document.getElementById('newExperienceCurrentPosition')?.addEventListener('change', function() {
                const endDateInput = document.getElementById('newExperienceEndDate');
                endDateInput.disabled = this.checked;
                if (this.checked) {
                    endDateInput.value = '';
                }
            });
            
            document.getElementById('editExperienceCurrentPosition')?.addEventListener('change', function() {
                const endDateInput = document.getElementById('editExperienceEndDate');
                endDateInput.disabled = this.checked;
                if (this.checked) {
                    endDateInput.value = '';
                }
            });
            
            // Handle "In Progress" checkbox for Education
            document.getElementById('newEducationInProgress')?.addEventListener('change', function() {
                const endDateInput = document.getElementById('newEducationEndDate');
                endDateInput.disabled = this.checked;
                if (this.checked) {
                    endDateInput.value = '';
                }
            });
            
            document.getElementById('editEducationInProgress')?.addEventListener('change', function() {
                const endDateInput = document.getElementById('editEducationEndDate');
                endDateInput.disabled = this.checked;
                if (this.checked) {
                    endDateInput.value = '';
                }
            });
            
            // Store the active tab in session storage
            const triggerEl = document.querySelector('button[data-bs-toggle="tab"]');
            if (triggerEl) {
                triggerEl.addEventListener('shown.bs.tab', function(event) {
                    sessionStorage.setItem('activeProfileTab', event.target.getAttribute('data-bs-target'));
                });
                
                // Set active tab based on session storage
                const activeTab = sessionStorage.getItem('activeProfileTab');
                if (activeTab) {
                    const tab = new bootstrap.Tab(document.querySelector('button[data-bs-target="' + activeTab + '"]'));
                    tab.show();
                }
            }
        });
    </script>
} 