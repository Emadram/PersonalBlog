@page
@model PersonalBlog.Pages.Admin.ProfileModel
@{
    ViewData["Title"] = "Profile";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Manage Profile</h1>
        <p class="text-muted mb-0">Customize your personal information and resume</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary" onclick="document.getElementById('saveProfileBtn').click()">
            <i class="fas fa-save me-2"></i>Save Changes
        </button>
    </div>
</div>
    
    @if (Model.SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            <ul class="nav nav-pills nav-fill nav-tabs-alt" id="profileTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-0 active" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal" type="button" role="tab" aria-controls="personal" aria-selected="true">
                        <i class="fas fa-user me-2"></i>Personal Info
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-0" id="skill-categories-tab" data-bs-toggle="tab" data-bs-target="#skill-categories" type="button" role="tab" aria-controls="skill-categories" aria-selected="false">
                        <i class="fas fa-folder me-2"></i>Skill Categories
                    </button>
                    <button class="nav-link rounded-0" id="skills-tab" data-bs-toggle="tab" data-bs-target="#skills" type="button" role="tab" aria-controls="skills" aria-selected="false">
                        <i class="fas fa-code me-2"></i>Skills
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-0" id="experience-tab" data-bs-toggle="tab" data-bs-target="#experience" type="button" role="tab" aria-controls="experience" aria-selected="false">
                        <i class="fas fa-briefcase me-2"></i>Experience
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-0" id="education-tab" data-bs-toggle="tab" data-bs-target="#education" type="button" role="tab" aria-controls="education" aria-selected="false">
                        <i class="fas fa-graduation-cap me-2"></i>Education
                    </button>
                </li>
            </ul>
        </div>
    </div>
    
    <div class="tab-content" id="profileTabsContent">
        <!-- Personal Information Tab -->
        <div class="tab-pane fade show active" id="personal" role="tabpanel" aria-labelledby="personal-tab">
            <form method="post" asp-page-handler="UpdateProfile">
                <input type="hidden" asp-for="Profile.Id" />
                <div class="row">
                    <div class="col-md-3 mb-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body text-center p-4">
                                <div class="mb-3">
                                    @if (!string.IsNullOrEmpty(Model.Profile.ImageUrl))
                                    {
                                        <img src="@Model.Profile.ImageUrl" class="rounded-circle mb-3" alt="@Model.Profile.Name" style="width: 120px; height: 120px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="avatar-placeholder rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center bg-light" style="width: 120px; height: 120px;">
                                            <i class="fas fa-user fa-3x text-muted"></i>
                                        </div>
                                    }
                                </div>
                                <h5 class="mb-1">@Model.Profile.Name</h5>
                                <p class="text-muted mb-3">@Model.Profile.Title</p>
                                <div class="d-grid">
                                    <button type="button" class="btn btn-outline-primary" id="changePhotoBtn">
                                        <i class="fas fa-camera me-2"></i>Change Photo
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-9 mb-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3">
                                <h5 class="mb-0">Personal Information</h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="Profile.Name" class="form-label small text-muted">Full Name</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-user text-muted"></i>
                                            </span>
                                            <input asp-for="Profile.Name" class="form-control border-start-0" placeholder="Enter your full name" />
                                        </div>
                                        <span asp-validation-for="Profile.Name" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <label asp-for="Profile.Title" class="form-label small text-muted">Title/Position</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-briefcase text-muted"></i>
                                            </span>
                                            <input asp-for="Profile.Title" class="form-control border-start-0" placeholder="e.g. Software Engineer" />
                                        </div>
                                        <span asp-validation-for="Profile.Title" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="col-12">
                                        <label asp-for="Profile.Bio" class="form-label small text-muted">Bio</label>
                                        <textarea asp-for="Profile.Bio" class="form-control" rows="4" placeholder="A brief description about yourself"></textarea>
                                        <span asp-validation-for="Profile.Bio" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <label asp-for="Profile.Location" class="form-label small text-muted">Location</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-map-marker-alt text-muted"></i>
                                            </span>
                                            <input asp-for="Profile.Location" class="form-control border-start-0" placeholder="e.g. New York, NY" />
                                        </div>
                                        <span asp-validation-for="Profile.Location" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <label asp-for="Profile.Email" class="form-label small text-muted">Email</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-envelope text-muted"></i>
                                            </span>
                                            <input asp-for="Profile.Email" class="form-control border-start-0" placeholder="your.email@example.com" />
                                        </div>
                                        <span asp-validation-for="Profile.Email" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <label asp-for="Profile.Phone" class="form-label small text-muted">Phone</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-phone text-muted"></i>
                                            </span>
                                            <input asp-for="Profile.Phone" class="form-control border-start-0" placeholder="+1 (555) 123-4567" />
                                        </div>
                                        <span asp-validation-for="Profile.Phone" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <label asp-for="Profile.ImageUrl" class="form-label small text-muted">Profile Image URL</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fas fa-image text-muted"></i>
                                            </span>
                                            <input asp-for="Profile.ImageUrl" class="form-control border-start-0" placeholder="https://" />
                                        </div>
                                        <span asp-validation-for="Profile.ImageUrl" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Social Links</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Profile.GitHubUrl" class="form-label">GitHub URL</label>
                                <input asp-for="Profile.GitHubUrl" class="form-control" />
                                <span asp-validation-for="Profile.GitHubUrl" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="Profile.LinkedInUrl" class="form-label">LinkedIn URL</label>
                                <input asp-for="Profile.LinkedInUrl" class="form-control" />
                                <span asp-validation-for="Profile.LinkedInUrl" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="Profile.TwitterUrl" class="form-label">Twitter URL</label>
                                <input asp-for="Profile.TwitterUrl" class="form-control" />
                                <span asp-validation-for="Profile.TwitterUrl" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="Profile.ResumeUrl" class="form-label">Resume URL</label>
                                <input asp-for="Profile.ResumeUrl" class="form-control" />
                                <span asp-validation-for="Profile.ResumeUrl" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Dual-Persona Theme Colors</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-header bg-white">
                                        <h6 class="mb-0">Project Manager Mode (Light)</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="Profile.LightModeColor" class="form-label">Primary Color</label>
                                            <div class="input-group">
                                                <input type="color" class="form-control form-control-color" asp-for="Profile.LightModeColor" />
                                                <input type="text" class="form-control" asp-for="Profile.LightModeColor" placeholder="#3498db" />
                                            </div>
                                            <small class="text-muted">Main color for light mode (default: #3498db - light blue)</small>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label asp-for="Profile.LightModeSecondaryColor" class="form-label">Secondary Color</label>
                                            <div class="input-group">
                                                <input type="color" class="form-control form-control-color" asp-for="Profile.LightModeSecondaryColor" />
                                                <input type="text" class="form-control" asp-for="Profile.LightModeSecondaryColor" placeholder="#2980b9" />
                                            </div>
                                            <small class="text-muted">Used for gradients and hover states (default: #2980b9)</small>
                                        </div>
                                        
                                        <div class="p-3 border rounded" style="background: linear-gradient(to right, var(--bs-primary), var(--bs-primary-dark))">
                                            <div class="d-flex justify-content-between align-items-center text-white">
                                                <span>Preview</span>
                                                <i class="fas fa-user-tie"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6 mb-4">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-header bg-white">
                                        <h6 class="mb-0">Developer Mode (Dark)</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="Profile.DarkModeColor" class="form-label">Primary Color</label>
                                            <div class="input-group">
                                                <input type="color" class="form-control form-control-color" asp-for="Profile.DarkModeColor" />
                                                <input type="text" class="form-control" asp-for="Profile.DarkModeColor" placeholder="#00bfff" />
                                            </div>
                                            <small class="text-muted">Main color for dark mode (default: #00bfff - neon blue)</small>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label asp-for="Profile.DarkModeSecondaryColor" class="form-label">Secondary Color</label>
                                            <div class="input-group">
                                                <input type="color" class="form-control form-control-color" asp-for="Profile.DarkModeSecondaryColor" />
                                                <input type="text" class="form-control" asp-for="Profile.DarkModeSecondaryColor" placeholder="#0099cc" />
                                            </div>
                                            <small class="text-muted">Used for gradients and hover states (default: #0099cc)</small>
                                        </div>
                                        
                                        <div class="p-3 border rounded bg-dark" style="background: linear-gradient(to right, var(--bs-primary-dark), var(--bs-primary))">
                                            <div class="d-flex justify-content-between align-items-center text-white">
                                                <span>Preview</span>
                                                <i class="fas fa-laptop-code"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="d-flex justify-content-between">
                    <a asp-page="/Admin/Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Save Personal Info
                    </button>
                </div>
            </form>
        </div>
        
        <!-- Skill Categories Tab -->
        <div class="tab-pane fade" id="skill-categories" role="tabpanel" aria-labelledby="skill-categories-tab">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Skill Categories</h5>
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addSkillCategoryModal">
                        <i class="fas fa-plus-circle me-2"></i>Add Category
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Order</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in Model.SkillCategories)
                                {
                                    <tr>
                                        <td>@category.Name</td>
                                        <td>@category.Description</td>
                                        <td>@category.Order</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary edit-skill-category-btn" 
                                                    data-id="@category.Id"
                                                    data-name="@category.Name"
                                                    data-description="@category.Description"
                                                    data-order="@category.Order">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <form method="post" asp-page-handler="DeleteSkillCategory" asp-route-id="@category.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this category? Skills in this category will be set to uncategorized.')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.SkillCategories.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-3">No skill categories found. Add your first category!</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Skills Tab -->
        <div class="tab-pane fade" id="skills" role="tabpanel" aria-labelledby="skills-tab">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Skills</h5>
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addSkillModal">
                        <i class="fas fa-plus-circle me-2"></i>Add Skill
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Category</th>
                                    <th>Proficiency</th>
                                    <th>Icon</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var skill in Model.Skills)
                                {
                                    <tr>
                                        <td>@skill.Name</td>
                                        <td>@skill.Category</td>
                                        <td>
                                            <span class="badge bg-secondary mb-1">@skill.ProficiencyLevel</span>
                                            <div class="progress">
                                                <div class="progress-bar" role="progressbar" 
                                                     style="width: @skill.Proficiency%; @(string.IsNullOrEmpty(skill.IconColor) ? "" : $"background-color: {skill.IconColor};")" 
                                                     aria-valuenow="@skill.Proficiency" aria-valuemin="0" aria-valuemax="100">
                                                    @skill.Proficiency%
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <i class="@skill.IconClass" style="@(string.IsNullOrEmpty(skill.IconColor) ? "" : $"color: {skill.IconColor};")"></i> 
                                            @skill.IconClass 
                                            @if (!string.IsNullOrEmpty(skill.IconColor)) {
                                                <span class="badge" style="background-color: @skill.IconColor">@skill.IconColor</span>
                                            }
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary edit-skill-btn" 
                                                    data-id="@skill.Id"
                                                    data-name="@skill.Name"
                                                    data-category="@skill.Category"
                                                    data-category-id="@skill.CategoryId"
                                                    data-proficiency="@skill.Proficiency"
                                                    data-proficiency-level="@skill.ProficiencyLevel"
                                                    data-icon="@skill.IconClass"
                                                    data-icon-color="@skill.IconColor">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <form method="post" asp-page-handler="DeleteSkill" asp-route-id="@skill.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this skill?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.Skills.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-3">No skills found. Add your first skill!</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Experience Tab -->
        <div class="tab-pane fade" id="experience" role="tabpanel" aria-labelledby="experience-tab">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Experience</h5>
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addExperienceModal">
                        <i class="fas fa-plus-circle me-2"></i>Add Experience
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Company</th>
                                    <th>Date Range</th>
                                    <th>Order</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exp in Model.Experiences)
                                {
                                    <tr>
                                        <td>@exp.Title</td>
                                        <td>@exp.Company</td>
                                        <td>
                                            @exp.StartDate.ToString("MMM yyyy") - 
                                            @(exp.EndDate.HasValue ? exp.EndDate.Value.ToString("MMM yyyy") : "Present")
                                        </td>
                                        <td>@exp.Order</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary edit-experience-btn"
                                                    data-id="@exp.Id">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <form method="post" asp-page-handler="DeleteExperience" asp-route-id="@exp.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this experience?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.Experiences.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-3">No experience entries found. Add your first experience!</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Education Tab -->
        <div class="tab-pane fade" id="education" role="tabpanel" aria-labelledby="education-tab">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Education</h5>
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addEducationModal">
                        <i class="fas fa-plus-circle me-2"></i>Add Education
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Degree</th>
                                    <th>Institution</th>
                                    <th>Date Range</th>
                                    <th>Order</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var edu in Model.Educations)
                                {
                                    <tr>
                                        <td>@edu.Degree</td>
                                        <td>@edu.Institution</td>
                                        <td>
                                            @edu.StartDate.ToString("MMM yyyy") - 
                                            @(edu.EndDate.HasValue ? edu.EndDate.Value.ToString("MMM yyyy") : "Present")
                                        </td>
                                        <td>@edu.Order</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary edit-education-btn"
                                                    data-id="@edu.Id">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <form method="post" asp-page-handler="DeleteEducation" asp-route-id="@edu.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this education entry?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.Educations.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-3">No education entries found. Add your first education!</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Skill Category Modal -->
<div class="modal fade" id="addSkillCategoryModal" tabindex="-1" aria-labelledby="addSkillCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddSkillCategory">
                <div class="modal-header">
                    <h5 class="modal-title" id="addSkillCategoryModalLabel">Add New Skill Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newCategoryName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="newCategoryName" name="newCategory.Name" required>
                    </div>
                    <div class="mb-3">
                        <label for="newCategoryDescription" class="form-label">Description</label>
                        <input type="text" class="form-control" id="newCategoryDescription" name="newCategory.Description">
                    </div>
                    <div class="mb-3">
                        <label for="newCategoryOrder" class="form-label">Display Order</label>
