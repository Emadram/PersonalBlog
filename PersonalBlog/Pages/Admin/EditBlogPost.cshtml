@page "{id:int?}"
@model PersonalBlog.Pages.Admin.EditBlogPostModel
@{
    ViewData["Title"] = Model.IsNew ? "Create Blog Post" : "Edit Blog Post";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-edit me-2"></i>
            @(Model.IsNew ? "Create New Blog Post" : "Edit Blog Post")
        </h2>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Post.Id" />
        
        <div class="row">
            <div class="col-md-9">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Post Content</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Post.Title" class="form-label">Title</label>
                            <input asp-for="Post.Title" class="form-control" />
                            <span asp-validation-for="Post.Title" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Post.Slug" class="form-label">Slug</label>
                            <div class="input-group">
                                <span class="input-group-text">/blog/</span>
                                <input asp-for="Post.Slug" class="form-control" placeholder="Generated from title if empty" />
                            </div>
                            <span asp-validation-for="Post.Slug" class="text-danger"></span>
                            <small class="text-muted">Leave empty to generate automatically from title.</small>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Post.Summary" class="form-label">Summary</label>
                            <textarea asp-for="Post.Summary" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Post.Summary" class="text-danger"></span>
                            <small class="text-muted">A brief description that appears in blog lists.</small>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Post.Content" class="form-label">Content</label>
                            <textarea asp-for="Post.Content" class="form-control" rows="10"></textarea>
                            <span asp-validation-for="Post.Content" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Post.PublishedDate" class="form-label">Publish Date</label>
                            <input type="date" asp-for="Post.PublishedDate" class="form-control" value="@Model.Post.PublishedDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="Post.PublishedDate" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Categories</label>
                            <div class="list-group" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var category in Model.AllCategories)
                                {
                                    <div class="list-group-item">
                                        <input class="form-check-input me-1" type="checkbox" name="SelectedCategoryIds" value="@category.Id" id="category-@category.Id" 
                                               @(Model.SelectedCategoryIds.Contains(category.Id) ? "checked" : "")>
                                        <label class="form-check-label stretched-link" for="category-@category.Id">
                                            @category.Name
                                            <span class="badge bg-@category.BadgeColor ms-2">@category.BadgeColor</span>
                                        </label>
                                    </div>
                                }
                                @if (!Model.AllCategories.Any())
                                {
                                    <p class="text-muted">No categories available. Please add categories via the admin panel.</p>
                                }
                            </div>
                            <!-- TODO: Add a link/button to a separate Category Management page -->
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Post.ImageUrl" class="form-label">Image URL</label>
                            <input asp-for="Post.ImageUrl" class="form-control" placeholder="https://" />
                            <span asp-validation-for="Post.ImageUrl" class="text-danger"></span>
                            <small class="text-muted">URL to featured image for this post.</small>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Post.ReadMinutes" class="form-label">Read Time (minutes)</label>
                            <input asp-for="Post.ReadMinutes" type="number" class="form-control" min="1" />
                            <span asp-validation-for="Post.ReadMinutes" class="text-danger"></span>
                        </div>
                        
                        <div class="form-check mb-3">
                            <input asp-for="Post.IsFeatured" class="form-check-input" type="checkbox" />
                            <label asp-for="Post.IsFeatured" class="form-check-label">Featured Post</label>
                            <p class="text-muted small">Featured posts appear at the top of the blog page.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="d-flex justify-content-between">
            <a asp-page="/Admin/BlogPosts" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Posts
            </a>
            <div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Save Post
                </button>
            </div>
        </div>
    </form>
    
    <!-- New Category Modal (Commented out for now) -->
    <!--
    <div class="modal fade" id="newCategoryModal" tabindex="-1" aria-labelledby="newCategoryModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="newCategoryModalLabel">Add New Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newCategory" class="form-label">Category Name</label>
                        <input type="text" id="newCategory" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="addCategoryBtn">Add Category</button>
                </div>
            </div>
        </div>
    </div>
    -->
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-generate slug when typing title
            const titleInput = document.getElementById('Post_Title');
            const slugInput = document.getElementById('Post_Slug');
            
            titleInput.addEventListener('input', function() {
                if (slugInput.value === '') {
                    slugInput.value = titleInput.value
                        .toLowerCase()
                        .replace(/[^a-z0-9\s]/g, '')
                        .replace(/\s+/g, '-');
                }
            });
        });
    </script>
} 