@page
@model PersonalBlog.Pages.Admin.PodcastsModel
@{
    ViewData["Title"] = "Manage Podcasts";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-microphone me-2"></i>Manage Podcast Episodes</h2>
        <a asp-page="/Admin/EditPodcast" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>Add New Episode
        </a>
    </div>
    
    @if (Model.SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="card">
        <div class="card-header bg-light">
            <div class="row">
                <div class="col">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Search episodes...">
                    </div>
                </div>
                <div class="col-auto">
                    <select class="form-select" id="categoryFilter">
                        <option value="">All Categories</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;"></th>
                        <th>Episode</th>
                        <th>Category</th>
                        <th>Duration</th>
                        <th>Published Date</th>
                        <th style="width: 120px;">Featured</th>
                        <th style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var episode in Model.Episodes)
                    {
                        <tr class="episode-row" data-category="@episode.Category">
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(episode.ImageUrl))
                                {
                                    <img src="@episode.ImageUrl" alt="@episode.Title" class="rounded" style="width: 40px; height: 40px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded bg-light d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
                                        <i class="fas fa-podcast text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div>@episode.Title</div>
                                <small class="text-muted">Episode @episode.EpisodeNumber</small>
                            </td>
                            <td>
                                <span class="badge bg-@episode.CategoryBadgeColor">@episode.Category</span>
                            </td>
                            <td>@episode.DurationMinutes min</td>
                            <td>@episode.PublishedDate.ToString("MMM d, yyyy")</td>
                            <td class="text-center">
                                <form method="post" asp-page-handler="ToggleFeatured" asp-route-id="@episode.Id">
                                    <button type="submit" class="btn btn-sm @(episode.IsFeatured ? "btn-warning" : "btn-outline-secondary")">
                                        @if (episode.IsFeatured)
                                        {
                                            <i class="fas fa-star me-1"></i> <span>Featured</span>
                                        }
                                        else
                                        {
                                            <i class="far fa-star me-1"></i> <span>Feature</span>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-page="/Admin/EditPodcast" asp-route-id="@episode.Id" class="btn btn-sm btn-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@episode.Id">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                                
                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal-@episode.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@episode.Id" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="deleteModalLabel-@episode.Id">Confirm Deletion</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete the episode "<strong>@episode.Title</strong>"? This action cannot be undone.
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@episode.Id">
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Episodes.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <div class="text-muted mb-2"><i class="fas fa-info-circle me-2"></i>No podcast episodes found</div>
                                <a asp-page="/Admin/EditPodcast" class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus-circle me-2"></i>Add Your First Episode
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="mt-3">
        <a asp-page="/Admin/Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Search functionality
            const searchInput = document.getElementById('searchInput');
            const categoryFilter = document.getElementById('categoryFilter');
            const episodeRows = document.querySelectorAll('.episode-row');
            
            function filterEpisodes() {
                const searchTerm = searchInput.value.toLowerCase();
                const categoryValue = categoryFilter.value;
                
                episodeRows.forEach(row => {
                    const titleContent = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
                    const rowCategory = row.getAttribute('data-category');
                    
                    const matchesSearch = titleContent.includes(searchTerm);
                    const matchesCategory = categoryValue === '' || rowCategory === categoryValue;
                    
                    row.style.display = (matchesSearch && matchesCategory) ? '' : 'none';
                });
            }
            
            searchInput.addEventListener('input', filterEpisodes);
            categoryFilter.addEventListener('change', filterEpisodes);
        });
    </script>
} 