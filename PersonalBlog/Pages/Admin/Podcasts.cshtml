@page
@model PersonalBlog.Pages.Admin.PodcastsModel
@{
    ViewData["Title"] = "Podcasts";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Podcast Episodes</h1>
        <p class="text-muted mb-0">Manage your podcast episodes and content</p>
    </div>
    <div>
        <a asp-page="/Admin/EditPodcast" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>New Episode
        </a>
    </div>
</div>
    
    @if (Model.SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 py-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Search episodes...">
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" id="categoryFilter">
                    <option value="">All Categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" id="statusFilter">
                    <option value="">All Status</option>
                    <option value="published">Published</option>
                    <option value="draft">Draft</option>
                    <option value="scheduled">Scheduled</option>
                </select>
            </div>
            <div class="col-md-2 text-md-end">
                <button class="btn btn-outline-secondary" type="button" id="filterButton">
                    <i class="fas fa-filter me-1"></i> Filter
                </button>
            </div>
        </div>
    </div>
        <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="selectAll">
                        </div>
                    </th>
                    <th>Episode</th>
                    <th>Category</th>
                    <th>Duration</th>
                    <th>Status</th>
                    <th>Published Date</th>
                    <th>Featured</th>
                    <th style="width: 60px;">Actions</th>
                </tr>
            </thead>
                <tbody>
                    @foreach (var episode in Model.Episodes)
                    {
                        <tr class="episode-row" data-category="@episode.Category" data-status="@(episode.PublishedDate <= DateTime.Now ? "published" : "scheduled")">
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input row-checkbox" type="checkbox" value="@episode.Id">
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0 me-3">
                                        @if (!string.IsNullOrEmpty(episode.ImageUrl))
                                        {
                                            <img src="@episode.ImageUrl" alt="@episode.Title" class="rounded" style="width: 48px; height: 48px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded bg-light d-flex justify-content-center align-items-center" style="width: 48px; height: 48px;">
                                                <i class="fas fa-podcast text-muted"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0">@episode.Title</h6>
                                        <small class="text-muted">Episode @episode.EpisodeNumber</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-@episode.CategoryBadgeColor">@episode.Category</span>
                            </td>
                            <td>@episode.DurationMinutes min</td>
                            <td>
                                @if (episode.PublishedDate <= DateTime.Now)
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Scheduled</span>
                                }
                            </td>
                            <td>@episode.PublishedDate.ToString("MMM d, yyyy")</td>
                            <td>
                                <div class="form-check form-switch d-inline-block">
                                    <form method="post" asp-page-handler="ToggleFeatured" asp-route-id="@episode.Id" class="d-inline">
                                        <input class="form-check-input" type="checkbox" @(episode.IsFeatured ? "checked" : "") 
                                               onchange="this.form.submit()" role="switch" id="featured-@episode.Id">
                                        <label class="form-check-label" for="featured-@episode.Id">
                                            @(episode.IsFeatured ? "Yes" : "No")
                                        </label>
                                    </form>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenuButton-@episode.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton-@episode.Id">
                                            <li>
                                                <a class="dropdown-item" href="/podcast/@episode.Slug" target="_blank">
                                                    <i class="fas fa-play-circle me-2"></i>Play
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="/Admin/EditPodcast/@episode.Id">
                                                    <i class="fas fa-edit me-2"></i>Edit
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="#" data-bs-toggle="modal" data-bs-target="#deleteModal-@episode.Id">
                                                    <i class="fas fa-trash-alt me-2"></i>Delete
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@episode.Id">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                                
                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal-@episode.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@episode.Id" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="deleteModalLabel-@episode.Id">Confirm Deletion</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete the episode "<strong>@episode.Title</strong>"? This action cannot be undone.
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@episode.Id">
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Episodes.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <div class="text-muted mb-2"><i class="fas fa-info-circle me-2"></i>No podcast episodes found</div>
                                <a asp-page="/Admin/EditPodcast" class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus-circle me-2"></i>Add Your First Episode
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Bulk Actions -->
<div class="card border-0 shadow-sm mt-4">
    <div class="card-body py-2">
        <div class="d-flex justify-content-between align-items-center">
            <div class="form-check d-flex align-items-center">
                <input class="form-check-input me-2" type="checkbox" id="selectAllBottom">
                <label class="form-check-label text-muted small" for="selectAllBottom">
                    Select all <span id="selectedCount">0</span> items
                </label>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="bulkPublishBtn">
                    <i class="fas fa-check-circle me-1"></i> Publish
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="bulkUnpublishBtn">
                    <i class="fas fa-ban me-1"></i> Unpublish
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" id="bulkDeleteBtn">
                    <i class="fas fa-trash-alt me-1"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Pagination -->
<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item disabled">
            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                <i class="fas fa-chevron-left"></i>
            </a>
        </li>
        <li class="page-item active"><a class="page-link" href="#">1</a></li>
        <li class="page-item"><a class="page-link" href="#">2</a></li>
        <li class="page-item"><a class="page-link" href="#">3</a></li>
        <li class="page-item">
            <a class="page-link" href="#">
                <i class="fas fa-chevron-right"></i>
            </a>
        </li>
    </ul>
</div>

@section Styles {
    <style>
        .table th {
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
            border-top: none;
            border-bottom: 1px solid #e9ecef;
        }
        
        .table td {
            vertical-align: middle;
            padding: 1rem 0.75rem;
        }
        
        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        
        .dropdown-toggle::after {
            display: none;
        }
        
        .form-switch .form-check-input {
            width: 2.5em;
            margin-left: -2.5em;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='%28(,var%28--bs-body-bg-rgb%29,.5)'/%3e%3c/svg%3e");
        }
        
        .form-switch .form-check-input:checked {
            background-position: right center;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='%23fff'/%3e%3c/svg%3e");
        }
        
        .pagination .page-link {
            color: #495057;
            border: 1px solid #dee2e6;
            margin: 0 2px;
            border-radius: 4px;
            min-width: 36px;
            text-align: center;
        }
        
        .pagination .page-item.active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        
        .pagination .page-item.disabled .page-link {
            color: #6c757d;
            background-color: #fff;
            border-color: #dee2e6;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Search functionality with debounce
            let searchTimer;
            $("#searchInput").on("keyup", function() {
                clearTimeout(searchTimer);
                const $this = $(this);
                searchTimer = setTimeout(function() {
                    const value = $this.val().toLowerCase();
                    $(".episode-row").each(function() {
                        const $row = $(this);
                        const text = $row.text().toLowerCase();
                        $row.toggle(text.indexOf(value) > -1);
                    });
                }, 300);
            });
            
            // Category filter
            $("#categoryFilter, #statusFilter").on("change", function() {
                const category = $("#categoryFilter").val().toLowerCase();
                const status = $("#statusFilter").val().toLowerCase();
                
                $(".episode-row").each(function() {
                    const $row = $(this);
                    const rowCategory = $row.data("category").toLowerCase();
                    const rowStatus = $row.data("status").toLowerCase();
                    
                    const categoryMatch = category === "" || rowCategory === category;
                    const statusMatch = status === "" || rowStatus === status;
                    
                    $row.toggle(categoryMatch && statusMatch);
                });
            });
            
            // Row selection
            function updateSelectedCount() {
                const count = $(".row-checkbox:checked").length;
                $("#selectedCount").text(count);
                $("#selectAll, #selectAllBottom").prop("checked", 
                    count > 0 && count === $(".row-checkbox").length);
            }
            
            $(".row-checkbox").on("change", updateSelectedCount);
            
            // Select all checkboxes
            $("#selectAll, #selectAllBottom").on("change", function() {
                const isChecked = $(this).is(":checked");
                $(".row-checkbox, #selectAll, #selectAllBottom").prop("checked", isChecked);
                updateSelectedCount();
            });
            
            // Bulk actions
            $("#bulkPublishBtn").on("click", function() {
                const selectedIds = [];
                $(".row-checkbox:checked").each(function() {
                    selectedIds.push($(this).val());
                });
                
                if (selectedIds.length > 0) {
                    if (confirm(`Publish ${selectedIds.length} selected episodes?`)) {
                        // Implement publish logic here
                        console.log("Publishing episodes:", selectedIds);
                    }
                } else {
                    alert("Please select at least one episode to publish.");
                }
            });
            
            $("#bulkUnpublishBtn").on("click", function() {
                const selectedIds = [];
                $(".row-checkbox:checked").each(function() {
                    selectedIds.push($(this).val());
                });
                
                if (selectedIds.length > 0) {
                    if (confirm(`Unpublish ${selectedIds.length} selected episodes?`)) {
                        // Implement unpublish logic here
                        console.log("Unpublishing episodes:", selectedIds);
                    }
                } else {
                    alert("Please select at least one episode to unpublish.");
                }
            });
            
            $("#bulkDeleteBtn").on("click", function() {
                const selectedIds = [];
                $(".row-checkbox:checked").each(function() {
                    selectedIds.push($(this).val());
                });
                
                if (selectedIds.length > 0) {
                    if (confirm(`Are you sure you want to delete ${selectedIds.length} selected episodes? This action cannot be undone.`)) {
                        // Implement delete logic here
                        console.log("Deleting episodes:", selectedIds);
                    }
                } else {
                    alert("Please select at least one episode to delete.");
                }
            });
            
            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
} 