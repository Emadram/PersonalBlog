<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PersonalBlog</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PersonalBlog.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <i class="fas fa-code me-2"></i>Personal Blog
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">
                                <i class="fas fa-user me-1"></i> About
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Blog">
                                <i class="fas fa-blog me-1"></i> Blog
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Podcast">
                                <i class="fas fa-microphone me-1"></i> Podcast
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/News">
                                <i class="fas fa-newspaper me-1"></i> News
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex">
                        <a href="https://github.com/username" target="_blank" class="nav-link">
                            <i class="fab fa-github"></i>
                        </a>
                        <a href="https://linkedin.com/in/username" target="_blank" class="nav-link">
                            <i class="fab fa-linkedin"></i>
                        </a>
                        <a href="https://twitter.com/username" target="_blank" class="nav-link">
                            <i class="fab fa-twitter"></i>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-6">
                    <h5>Personal Blog</h5>
                    <p class="text-muted">A personal blog & portfolio showcasing work as a developer and project manager.</p>
                </div>
                <div class="col-md-3">
                    <h5>Connect</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="https://github.com/username"><i class="fab fa-github me-2"></i>GitHub</a></li>
                        <li class="mb-2"><a href="https://linkedin.com/in/username"><i class="fab fa-linkedin me-2"></i>LinkedIn</a></li>
                        <li class="mb-2"><a href="https://twitter.com/username"><i class="fab fa-twitter me-2"></i>Twitter</a></li>
                    </ul>
                </div>
                <div class="col-md-3 text-md-end">
                    <p>&copy; @DateTime.Now.Year - Personal Blog</p>
                    <a asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>