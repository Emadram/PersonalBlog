    <script>
        // Theme toggle functionality
        document.addEventListener('DOMContentLoaded', function() {
            const htmlElement = document.getElementById('htmlElement');
            const themeToggle = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');
            
            // Check if user preference is stored
            const savedTheme = localStorage.getItem('theme') || 'light';
            htmlElement.setAttribute('data-bs-theme', savedTheme);
            updateThemeIcon(savedTheme);
            applyThemeToComponents(savedTheme);
            
            // Theme toggle click handler
            themeToggle.addEventListener('click', function() {
                const currentTheme = htmlElement.getAttribute('data-bs-theme');
                const newTheme = currentTheme === 'light' ? 'dark' : 'light';
                
                // Apply theme change immediately
                htmlElement.setAttribute('data-bs-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                
                // Update all components with animation
                updateThemeIcon(newTheme);
                applyThemeToComponents(newTheme);
                applyThemeToAll(newTheme);
            });
            
            // Function to apply theme to ALL elements
            function applyThemeToAll(theme) {
                // Force immediate repaint of all elements
                document.body.style.display = 'none';
                void document.body.offsetHeight;
                document.body.style.display = '';
                
                // Apply theme to all components with inline style
                document.querySelectorAll('*').forEach(el => {
                    if (el.style.backgroundColor) {
                        el.style.backgroundColor = '';
                    }
                    if (el.style.color) {
                        el.style.color = '';
                    }
                    if (el.style.borderColor) {
                        el.style.borderColor = '';
                    }
                });
            }
            
            // Update theme visual indicators based on current theme
            function updateThemeIcon(theme) {
                const projectIcon = document.getElementById('projectIcon');
                const devIcon = document.getElementById('devIcon');
                
                if (theme === 'light') {
                    // In light mode, project manager icon is prominent
                    if (projectIcon) {
                        projectIcon.style.opacity = '1';
                        projectIcon.style.transform = 'scale(1)';
                    }
                    
                    if (devIcon) {
                        devIcon.style.opacity = '0.5';
                        devIcon.style.transform = 'scale(0.8)';
                    }
                    
                    themeToggle.setAttribute('title', 'Active: Project Manager Mode | Click for Developer Mode');
                } else {
                    // In dark mode, developer icon is prominent
                    if (projectIcon) {
                        projectIcon.style.opacity = '0.5';
                        projectIcon.style.transform = 'scale(0.8)';
                    }
                    
                    if (devIcon) {
                        devIcon.style.opacity = '1';
                        devIcon.style.transform = 'scale(1)';
                    }
                    
                    themeToggle.setAttribute('title', 'Active: Developer Mode | Click for Project Manager Mode');
                }
            }
            
            // Apply theme to bootstrap components and other elements
            function applyThemeToComponents() {
                const theme = htmlElement.getAttribute('data-bs-theme');
                
                // Apply to cards, dropdowns, and modals
                document.querySelectorAll('.card, .dropdown-menu, .modal-content').forEach(el => {
                    el.style.backgroundColor = theme === 'dark' ? 'var(--card-bg)' : '';
                    el.style.borderColor = theme === 'dark' ? 'var(--border-color)' : '';
                });
                
                // Apply to form elements - using CSS classes instead of inline styles
                document.querySelectorAll('.form-control, .form-select').forEach(el => {
                    // Remove any previous inline styles that might interfere
                    el.removeAttribute('style');
                    
                    // Force browser to recalculate styles based on current theme
                    void el.offsetWidth;
                });
                
                // Force repaint for all form controls to ensure they pick up new theme
                setTimeout(() => {
                    document.querySelectorAll('input, textarea, select').forEach(el => {
                        // Trigger repaint by briefly changing a non-visible property
                        const oldDisplay = el.style.display;
                        el.style.display = 'none';
                        void el.offsetHeight;
                        el.style.display = oldDisplay;
                    });
                }, 10);
                
                // Apply to tables
                document.querySelectorAll('table').forEach(table => {
                    if (theme === 'dark') {
                        table.classList.add('table-dark');
                    } else {
                        table.classList.remove('table-dark');
                    }
                });
                
                // Apply to tech badges
                document.querySelectorAll('.tech-badge').forEach(badge => {
                    if (theme === 'dark') {
                        badge.style.backgroundColor = '#2c3034';
                        badge.style.color = '#ecf0f1';
                        badge.style.borderColor = '#495057';
                    } else {
                        badge.style.backgroundColor = '#f0f2f5';
                        badge.style.color = '#2c3e50';
                        badge.style.borderColor = '#dee2e6';
                    }
                });
            }
            
            // Apply theme when it changes
            applyThemeToComponents();
            themeToggle.addEventListener('click', applyThemeToComponents);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- Scroll Animation and Hover Effects Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Make all animated elements visible by default
            const animatedElements = document.querySelectorAll('.animate-on-scroll');
            animatedElements.forEach(el => {
                // Apply animations immediately
                const animation = el.dataset.animation;
                el.classList.add(animation);
                
                // Make all staggered children visible immediately
                if (el.classList.contains('stagger-children')) {
                    Array.from(el.children).forEach(child => {
                        child.style.opacity = '1';
                        child.style.transform = 'translateY(0)';
                    });
                }
            });
            
            // Keep the observer for when scrolling but don't hide elements initially
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const el = entry.target;
                        const animation = el.dataset.animation;
                        
                        // Refresh animation by removing and adding the class
                        el.classList.remove(animation);
                        setTimeout(() => {
                            el.classList.add(animation);
                        }, 50);
                        
                        observer.unobserve(el);
                    }
                });
            }, {
                threshold: 0.1
            });
            
            animatedElements.forEach(el => {
                observer.observe(el);
            });
            
            // Add hover effect to all sections
            const sections = document.querySelectorAll('.mb-5');
            sections.forEach(section => {
                section.addEventListener('mouseenter', function() {
                    this.classList.add('section-hover');
                });
                
                section.addEventListener('mouseleave', function() {
                    this.classList.remove('section-hover');
                });
            });
            
            // Add floating effect to profile image
            const profileImage = document.querySelector('.profile-image');
            if (profileImage) {
                let floatAnimation = null;
                let startPos = { x: 0, y: 0 };
                
                profileImage.addEventListener('mouseenter', function() {
                    startPos = { 
                        x: parseFloat(getComputedStyle(this).getPropertyValue('transform-origin').split(' ')[0]) || 0,
                        y: parseFloat(getComputedStyle(this).getPropertyValue('transform-origin').split(' ')[1]) || 0
                    };
                    
                    // Create floating animation
                    let progress = 0;
                    clearInterval(floatAnimation);
                    floatAnimation = setInterval(() => {
                        progress += 0.01;
                        const x = Math.sin(progress) * 5;
                        const y = Math.cos(progress) * 5;
                        this.style.transform = `translate(${x}px, ${y}px) scale(1.05)`;
                    }, 30);
                });
                
                profileImage.addEventListener('mouseleave', function() {
                    clearInterval(floatAnimation);
                    this.style.transform = '';
                });
            }
            
            // Add interactive tech badge effects
            const techBadges = document.querySelectorAll('.tech-badge');
            techBadges.forEach(badge => {
                const theme = document.documentElement.getAttribute('data-bs-theme');
                const color = theme === 'dark' ? '#00bfff' : '#3498db';
                
                badge.addEventListener('click', function() {
                    // Create ripple effect
                    const ripple = document.createElement('span');
                    ripple.classList.add('ripple');
                    this.appendChild(ripple);
                    
                    const rect = this.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height);
                    ripple.style.width = ripple.style.height = `${size}px`;
                    ripple.style.left = `${0}px`;
                    ripple.style.top = `${0}px`;
                    
                    setTimeout(() => ripple.remove(), 600);
                });
            });
        });
    </script>
</body>
