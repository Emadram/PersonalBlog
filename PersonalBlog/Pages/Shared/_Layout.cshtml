<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Personal Blog</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PersonalBlog.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center @(ViewContext.RouteData.Values["Page"].ToString() == "/Index" ? "active" : "")" asp-area="" asp-page="/Index">
                    <i class="fas fa-code me-2 @(ViewContext.RouteData.Values["Page"].ToString() == "/Index" ? "text-primary" : "")"></i><span class="fw-bold @(ViewContext.RouteData.Values["Page"].ToString() == "/Index" ? "text-primary" : "")">Emad Ramezani</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"].ToString() == "/Blog" ? "active" : "")" asp-area="" asp-page="/Blog">
                                <i class="fas fa-blog me-1"></i> Blog
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"].ToString() == "/Podcast" ? "active" : "")" asp-area="" asp-page="/Podcast">
                                <i class="fas fa-microphone me-1"></i> Podcast
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Page"].ToString() == "/News" ? "active" : "")" asp-area="" asp-page="/News">
                                <i class="fas fa-newspaper me-1"></i> News
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <div id="theme-toggle" class="theme-toggle ms-2" title="Toggle dark mode">
                            <i class="fas fa-users-cog"></i>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-5 py-4 border-top">
        <div class="container text-center">
            <p class="mb-0">&copy; @DateTime.Now.Year Emad Ramezani - All rights reserved</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>