@page
@model PersonalBlog.Pages.NewsModel
@{
    ViewData["Title"] = "News";
}

<div class="container mt-4">

    <div class="card">
        <div class="card-body">
            <ol class="list-group list-group-flush">
                @{
                    int position = 1;
                    
                    if (Model.FeaturedNews != null)
                    {
                        <li class="list-group-item d-flex py-3 border-0">
                            <span class="text-muted me-3">@(position++).</span>
                            <div>
                                <a href="@Model.FeaturedNews.SourceUrl" class="fw-semibold text-decoration-none" target="_blank">@Model.FeaturedNews.Title</a>
                                <span class="ms-1 text-muted small">(@Model.FeaturedNews.Source)</span>
                                <div class="text-muted small">
                                    @Model.FeaturedNews.PublishedDate.ToString("MMMM d, yyyy") by @Model.FeaturedNews.Source | 
                                    <a href="#" class="text-decoration-none">@(new Random().Next(10, 100)) comments</a>
                                </div>
                            </div>
                        </li>
                    }
                    
                    foreach (var news in Model.RecentNews)
                    {
                        <li class="list-group-item d-flex py-3 border-0">
                            <span class="text-muted me-3">@(position++).</span>
                            <div>
                                <a href="@news.SourceUrl" class="fw-semibold text-decoration-none" target="_blank">@news.Title</a>
                                <span class="ms-1 text-muted small">(@news.Source)</span>
                                <div class="text-muted small">
                                    @news.PublishedDate.ToString("MMM d") | 
                                    <a href="#" class="text-decoration-none">@(new Random().Next(5, 50)) points</a> | 
                                    <a href="#" class="text-decoration-none">@(new Random().Next(2, 30)) comments</a>
                                </div>
                            </div>
                        </li>
                    }
                }
            </ol>

            <div class="text-center mt-4">
                <a href="#" class="btn btn-sm btn-outline-secondary">More</a>
            </div>
        </div>
    </div>
</div> 