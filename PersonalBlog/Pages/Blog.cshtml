@page
@model PersonalBlog.Pages.BlogModel
@{    
    ViewData["Title"] = Model.CurrentCategory != null ? $"Blog - {Model.CurrentCategory.Name}" : "Blog";
}

<div class="container">
    <div class="row mb-5">
        <div class="col-lg-8">
            <h1 class="mb-4 section-title">
                <i class="fas fa-blog me-2"></i>Blog - @(Model.CurrentCategory != null ? Model.CurrentCategory.Name : "All Posts")
            </h1>
            <p class="lead">
                Thoughts, tutorials, and insights on software development, 
                project management, and technology trends.
            </p>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Blog Categories</h5>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <a asp-page="/Blog" class="tag @(Model.CurrentCategory == null ? "active" : "")">All Posts</a>
                        @foreach (var category in Model.AllCategories)
                        {
                            <a asp-page="/Blog" asp-route-categoryId="@category.Id" class="tag @(Model.CurrentCategory?.Id == category.Id ? "active" : "")">@category.Name</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Post -->
    @if (Model.FeaturedPost != null)
    {
        <div class="section mb-5">
            <h2 class="section-title">Featured Post</h2>
            <div class="card">
                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-md-5">
                            <img src="@Model.FeaturedPost.ImageUrl" class="img-fluid rounded-start" alt="Featured post image" style="height: 100%; object-fit: cover;">
                        </div>
                        <div class="col-md-7">
                            <div class="card-body">
                                @if (Model.FeaturedPost.PostCategories != null && Model.FeaturedPost.PostCategories.Any())
                                {
                                    foreach (var pc in Model.FeaturedPost.PostCategories)
                                    {
                                        if (pc.Category != null)
                                        {
                                            <span class="badge bg-@pc.Category.BadgeColor me-1 mb-2">@pc.Category.Name</span>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary me-1 mb-2">Uncategorized</span>
                                }
                                <h3 class="card-title">@Model.FeaturedPost.Title</h3>
                                <p class="card-text text-muted">
                                    @Model.FeaturedPost.PublishedDate.ToString("MMMM d, yyyy") | @Model.FeaturedPost.ReadMinutes min read
                                </p>
                                <p class="card-text">
                                    @Model.FeaturedPost.Summary
                                </p>
                                <a asp-page="/Post" asp-route-slug="@Model.FeaturedPost.Slug" class="btn btn-primary">Read Full Post</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Blog Posts -->
    <div class="row mb-5">
        @foreach (var post in Model.PostsToDisplay)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 blog-post">
                    <img src="@post.ImageUrl" class="card-img-top" alt="Blog post image">
                    <div class="card-body">
                        @if (post.PostCategories != null && post.PostCategories.Any())
                        {
                            foreach (var pc in post.PostCategories)
                            {
                                if (pc.Category != null)
                                {
                                    <span class="badge bg-@pc.Category.BadgeColor me-1 mb-2">@pc.Category.Name</span>
                                }
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary me-1 mb-2">Uncategorized</span>
                        }
                        <h4 class="card-title">@post.Title</h4>
                        <div class="blog-post-meta">
                            <span><i class="far fa-calendar-alt me-1"></i> @post.PublishedDate.ToString("MMMM d, yyyy")</span>
                            <span class="ms-3"><i class="far fa-clock me-1"></i> @post.ReadMinutes min read</span>
                        </div>
                        <p class="card-text">
                            @post.Summary
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-page="/Post" asp-route-slug="@post.Slug" class="btn btn-sm btn-outline-primary">Read Post</a>
                            <div>
                                <span class="text-muted"><i class="far fa-comments me-1"></i> @post.CommentCount</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

