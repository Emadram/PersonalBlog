@page
@model PersonalBlog.Pages.BlogModel
@{    
    ViewData["Title"] = "Blog";
}

<div class="container">
    <div class="row mb-5">
        <div class="col-lg-8">
            <h1 class="mb-4 section-title"><i class="fas fa-blog me-2"></i>Tech Blog</h1>
            <p class="lead">
                Thoughts, tutorials, and insights on software development, 
                project management, and technology trends.
            </p>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Blog Categories</h5>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <a href="#" class="tag">All Posts</a>
                        @foreach (var category in Model.Categories)
                        {
                            <a href="#" class="tag">@category</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Post -->
    @if (Model.FeaturedPost != null)
    {
        <div class="section mb-5">
            <h2 class="section-title">Featured Post</h2>
            <div class="card">
                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-md-5">
                            <img src="@Model.FeaturedPost.ImageUrl" class="img-fluid rounded-start" alt="Featured post image" style="height: 100%; object-fit: cover;">
                        </div>
                        <div class="col-md-7">
                            <div class="card-body">
                                <span class="badge bg-@Model.FeaturedPost.CategoryBadgeColor mb-2">@Model.FeaturedPost.Category</span>
                                <h3 class="card-title">@Model.FeaturedPost.Title</h3>
                                <p class="card-text text-muted">
                                    @Model.FeaturedPost.PublishedDate.ToString("MMMM d, yyyy") | @Model.FeaturedPost.ReadMinutes min read
                                </p>
                                <p class="card-text">
                                    @Model.FeaturedPost.Summary
                                </p>
                                <a href="#" class="btn btn-primary">Read Full Post</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Blog Posts -->
    <div class="row mb-5">
        @foreach (var post in Model.RecentPosts)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 blog-post">
                    <img src="@post.ImageUrl" class="card-img-top" alt="Blog post image">
                    <div class="card-body">
                        <span class="badge bg-@post.CategoryBadgeColor mb-2">@post.Category</span>
                        <h4 class="card-title">@post.Title</h4>
                        <div class="blog-post-meta">
                            <span><i class="far fa-calendar-alt me-1"></i> @post.PublishedDate.ToString("MMMM d, yyyy")</span>
                            <span class="ms-3"><i class="far fa-clock me-1"></i> @post.ReadMinutes min read</span>
                        </div>
                        <p class="card-text">
                            @post.Summary
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="#" class="btn btn-sm btn-outline-primary">Read Post</a>
                            <div>
                                <span class="text-muted"><i class="far fa-comments me-1"></i> @post.CommentCount</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-center mb-5">
        <nav aria-label="Blog pagination">
            <ul class="pagination">
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a>
                </li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">Next</a>
                </li>
            </ul>
        </nav>
    </div>

    <!-- Code Snippet Example -->
    <div class="section mb-5">
        <h2 class="section-title">Latest Code Snippet</h2>
        <div class="card">
            <div class="card-header">
                Extension Methods for Working with Collections
            </div>
            <div class="card-body">
                <p>A set of useful extension methods for working with collections in C#:</p>
                <pre><code>public static class CollectionExtensions
{
    /// &lt;summary>
    /// Returns a safe enumerable that won't throw if the source is null
    /// &lt;/summary>
    public static IEnumerable&lt;T> SafeEnumerate&lt;T>(this IEnumerable&lt;T> source)
    {
        return source ?? Enumerable.Empty&lt;T>();
    }

    /// &lt;summary>
    /// Executes an action for each item in the collection
    /// &lt;/summary>
    public static void ForEach&lt;T>(this IEnumerable&lt;T> source, Action&lt;T> action)
    {
        if (source == null || action == null) return;
        
        foreach (var item in source)
        {
            action(item);
        }
    }

    /// &lt;summary>
    /// Returns whether the collection is null or empty
    /// &lt;/summary>
    public static bool IsNullOrEmpty&lt;T>(this IEnumerable&lt;T> source)
    {
        return source == null || !source.Any();
    }
}</code></pre>
                
                <div class="mt-3">
                    <span class="tag">C#</span>
                    <span class="tag">Extension Methods</span>
                    <span class="tag">Collections</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Subscribe Section -->
    <div class="section mb-5">
        <div class="card bg-light">
            <div class="card-body p-4 text-center">
                <h3><i class="fas fa-envelope me-2"></i>Subscribe to Blog Updates</h3>
                <p class="lead mb-4">
                    Get notified when I publish new articles, tutorials, and code samples.
                </p>
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <form method="post">
                            <div class="input-group mb-3">
                                <input type="email" class="form-control" placeholder="Your email" aria-label="Your email">
                                <button class="btn btn-primary" type="button">Subscribe</button>
                            </div>
                        </form>
                        <small class="text-muted">I respect your privacy. No spam, ever.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 