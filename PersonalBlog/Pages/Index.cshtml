@page
@model IndexModel
@{
    ViewData["Title"] = "About Me";
}

<div class="container">
    <!-- Profile Header Section -->
    <div class="profile-header animate__animated animate-on-scroll" data-animation="animate__fadeIn">
        <img src="@Model.Profile.ImageUrl" alt="Profile Photo" class="profile-image">
        <div>
            <h1 class="fw-bold mb-3 typing-animation"><span class="text-primary">@Model.Profile.Name</span></h1>
            <div class="mb-3">
                <span class="tech-badge">@Model.Profile.Title</span>
                <span class="tech-badge"><i class="fas fa-map-marker-alt me-1"></i>@Model.Profile.Location</span>
            </div>
            <div class="profile-bio mb-4">
                @Model.Profile.Bio
            </div>
            <div class="social-links">
                <a href="@Model.Profile.ResumeUrl" class="btn btn-primary me-2">
                    <i class="fas fa-download me-2"></i>Resume
                </a>
            </div>
        </div>
    </div>

    <!-- About Me Section -->
    <div class="mb-5 animate__animated animate-on-scroll" data-animation="animate__fadeInUp">
        <h2 class="section-header">About Me</h2>
        <p>@Model.Profile.Bio</p>
        <p><i class="fas fa-envelope me-2"></i>@Model.Profile.Email</p>
        <p><i class="fas fa-phone me-2"></i>@Model.Profile.Phone</p>
    </div>

    <!-- Tech Stack Section -->
    <div class="mb-5 animate__animated animate-on-scroll stagger-children" data-animation="animate__fadeInUp">
        <h2 class="section-header">Tech Stack</h2>
        
        @{
            var skillCategories = Model.Skills
                .GroupBy(s => s.Category)
                .Select(g => g.Key)
                .OrderBy(c => c)
                .ToList();
        }
        
        @foreach (var category in skillCategories)
        {
            <div class="mb-4">
                <h3 class="mb-3">@category</h3>
                <div class="row">
                    @foreach (var skill in Model.Skills.Where(s => s.Category == category).OrderByDescending(s => s.Proficiency))
                    {
                        <div class="col-md-6 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span><i class="@skill.IconClass me-2" style="@(string.IsNullOrEmpty(skill.IconColor) ? "" : $"color: {skill.IconColor};")" ></i> @skill.Name</span>
                                <span>@skill.Proficiency%</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar" role="progressbar" style="width: @(skill.Proficiency)%;" 
                                     aria-valuenow="@skill.Proficiency" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Experience Section -->
    <div class="mb-5 animate__animated animate-on-scroll stagger-children" data-animation="animate__fadeInLeft">
        <h2 class="section-header">Experience</h2>
        
        <div class="timeline">
            @foreach (var exp in Model.Experiences)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h4 class="mb-1">@exp.Title</h4>
                            <span class="text-muted">
                                @exp.StartDate.ToString("MMM yyyy") - 
                                @(exp.EndDate.HasValue ? exp.EndDate.Value.ToString("MMM yyyy") : "Present")
                            </span>
                        </div>
                        <h5 class="text-muted mb-3">@exp.Company</h5>
                        <p>@exp.Description</p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tech in exp.Technologies.Split(','))
                            {
                                <span class="tech-badge">@tech.Trim()</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Education Section -->
    <div class="mb-5 animate__animated animate-on-scroll stagger-children" data-animation="animate__fadeInRight">
        <h2 class="section-header">Education</h2>
        
        <div class="row">
            @foreach (var edu in Model.Educations)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <h4 class="mb-1">@edu.Degree</h4>
                                <span class="text-muted">
                                    @edu.StartDate.ToString("yyyy") - @edu.EndDate?.ToString("yyyy")
                                </span>
                            </div>
                            <h5 class="text-muted mb-3">@edu.Institution</h5>
                            <p>@edu.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Contact Section -->
    <div id="contact" class="mb-5 animate__animated animate-on-scroll stagger-children" data-animation="animate__fadeInUp">
        <h2 class="section-header">Contact Me</h2>
        
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-4 mb-md-0">
                        <h4 class="mb-3">Send a Message</h4>
                        <form method="post">
                            <div class="mb-3">
                                <input type="text" class="form-control theme-input" id="name" placeholder="Your name">
                            </div>
                            <div class="mb-3">
                                <input type="email" class="form-control theme-input" id="email" placeholder="your.email@example.com">
                            </div>
                            <div class="mb-3">
                                <textarea class="form-control theme-input" id="message" rows="4" placeholder="Your message"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane me-2"></i>Send Message
                            </button>
                        </form>
                    </div>
                    <div class="col-md-6">
                        <h4 class="mb-3">Connect with me</h4>
                        <p>I'm always interested in new projects and opportunities. Feel free to reach out through any of these channels:</p>
                        <ul class="list-unstyled">
                            <li class="mb-3">
                                <i class="fas fa-envelope me-2"></i>
                                <a href="mailto:@Model.Profile.Email">@Model.Profile.Email</a>
                            </li>
                            <li class="mb-3">
                                <i class="fas fa-phone me-2"></i>
                                <a href="tel:@Model.Profile.Phone">@Model.Profile.Phone</a>
                            </li>
                            <li class="mb-3">
                                <i class="fab fa-github me-2"></i>
                                <a href="@Model.Profile.GitHubUrl" target="_blank">@Model.Profile.GitHubUrl.Replace("https://", "")</a>
                            </li>
                            <li class="mb-3">
                                <i class="fab fa-linkedin me-2"></i>
                                <a href="@Model.Profile.LinkedInUrl" target="_blank">@Model.Profile.LinkedInUrl.Replace("https://", "")</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
